{
  "name": "carfax-pk",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm services:up && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint --max-warnings=0 eslint.config.mjs scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/env-init.mjs",
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait && docker compose -f infra/docker-compose.yml run --rm s3-init",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "services:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm services:up",
    "services:check": "node scripts/check-services.mjs",
    "services:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @carfax/db db:generate",
    "db:migrate": "pnpm --filter @carfax/db db:migrate",
    "db:studio": "pnpm --filter @carfax/db db:studio",
    "db:check": "pnpm --filter @carfax/db db:check",
    "db:provision-app-user": "pnpm --filter @carfax/db db:provision-app-user"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.4",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
