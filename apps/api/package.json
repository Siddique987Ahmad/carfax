{
  "name": "@carfax/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsup && node dist/openapi.js",
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@sentry/nestjs": "11.12.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@carfax/db": "workspace:*",
    "@carfax/shared": "workspace:*",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsup": "9.0.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.2"
  }
}
