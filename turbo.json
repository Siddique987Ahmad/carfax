{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "PORT",
    "LOG_LEVEL",
    "DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "APP_DB_PASSWORD",
    "DATABASE_POOL_MAX",
    "REDIS_URL",
    "SENTRY_DSN",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "S3_BUCKET_PHOTOS",
    "S3_BUCKET_REPORTS",
    "MESSAGING_PROVIDER",
    "PAYMENTS_PROVIDER",
    "SEED_ALLOW_REMOTE",
    "JWT_SECRET",
    "OTP_SECRET",
    "S3_PUBLIC_ENDPOINT",
    "PUBLIC_WEB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["!.next/cache/**", ".next/**", "build/**", "dist/**", "openapi.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:migrate": {
      "cache": false
    },
    "@carfax/api#dev": {
      "dependsOn": ["@carfax/db#db:migrate"],
      "cache": false,
      "persistent": true
    }
  }
}
