# Local development values, matching infra/docker-compose.yml.
# Copy to .env with `pnpm env:init`. Never put real secrets in any .env.example file.

# PostgreSQL (db/06): two users.
# The app (API, workers) connects as carfax_app, which can read and write rows but not change tables.
DATABASE_URL=postgres://carfax_app:carfax-app-local@localhost:5432/carfax
# Migrations run as the table owner. Never point the app at this one: the owner bypasses row-level security.
MIGRATION_DATABASE_URL=postgres://carfax:carfax@localhost:5432/carfax
# Password for carfax_app, set by `pnpm db:provision-app-user`. Real environments use the secret store.
APP_DB_PASSWORD=carfax-app-local

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (SeaweedFS locally, Cloudflare R2 in staging and production)
S3_ENDPOINT=http://localhost:8333
# For a phone on the same Wi-Fi: http://<this computer's LAN IP>:8333 (signed upload URLs use it).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=carfax
S3_SECRET_ACCESS_KEY=carfax-local-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PHOTOS=photos
S3_BUCKET_REPORTS=reports

# API (apps/api)
PORT=3000
LOG_LEVEL=info
# Sign-in (api/03). Local development values only; real environments use the secret store.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
OTP_SECRET=local-dev-otp-secret-change-me-0123456789
# Error reporting. Empty locally: Sentry is off.
SENTRY_DSN=

# Outside providers are faked locally, so nothing waits on account approvals (setup/02).
# console = print OTPs, WhatsApp and SMS messages to the terminal instead of sending them.
MESSAGING_PROVIDER=console
# fake = simulate payments; sandbox = provider test environments.
PAYMENTS_PROVIDER=fake
